# Copy to .env for local development. NEVER commit real values.
# On Vercel these are set in Project Settings -> Environment Variables
# (DATABASE_URL / DATABASE_URL_UNPOOLED are added automatically by the Neon integration).

# PostgreSQL (Neon). Pooled URL for the app, direct URL for schema changes.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin dashboard (/admin). Choose a long random password.
ADMIN_PASSWORD=""
# Secret used to sign the admin session cookie (24+ random characters).
SESSION_SECRET=""

# Online payments (Razorpay). Leave empty to keep online payment disabled -
# the checkout will then only offer "Pay on delivery" order requests.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
