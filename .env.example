# Copy to .env for local development. NEVER commit real values.
# On Vercel these are set in Project Settings -> Environment Variables
# (DATABASE_URL / DATABASE_URL_UNPOOLED are added automatically by the Neon integration).
# Contracts: docs/DECISIONS/0002-environment-and-payment-modes.md, 0003-test-and-database-safety.md

# PostgreSQL. Use a LOCAL or throwaway database for development - never production.
# Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://velora@127.0.0.1:5432/velora_dev"
DATABASE_URL_UNPOOLED="postgresql://velora@127.0.0.1:5432/velora_dev"

# development | test | preview | production. On Vercel, VERCEL_ENV wins and APP_ENV must match it.
APP_ENV="development"

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin dashboard (/admin). Choose a long random password.
ADMIN_PASSWORD=""
# Secret used to sign the admin session cookie (24+ random characters).
SESSION_SECRET=""

# Payments: mock (dev/test only) | request_only (default) | razorpay_test (dev/test/preview, rzp_test_ keys)
#           | razorpay_live (production only, rzp_live_ keys + RAZORPAY_LIVE_ENABLED=true)
PAYMENT_MODE="request_only"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_LIVE_ENABLED=""

# Mock payment confirmation (POST /api/payments/mock/confirm). Only exists when PAYMENT_MODE=mock in
# development/test. Shared secret (24+ chars) sent as the x-mock-confirm-key header. Leave empty to disable.
MOCK_PAYMENT_CONFIRM_KEY=""

# Order expiry job (GET /api/internal/orders/expire). Vercel Cron sends this as `Authorization: Bearer <value>`.
# Route is disabled (404) unless set to 24+ random characters. PAYMENT_WINDOW_MINUTES (min 15, default 60) is how long an
# unpaid online order may hold stock before it is cancelled.
CRON_SECRET=""
PAYMENT_WINDOW_MINUTES=""

# Write-capable tests and destructive scripts (seed, cleanup, migrate) only run when:
#   TEST_TARGET=disposable and the database host is loopback or listed in DISPOSABLE_DB_HOSTS.
TEST_TARGET=""
# Comma-separated hosts of throwaway remote databases (e.g. a Neon dev branch). Never production.
DISPOSABLE_DB_HOSTS=""
# Comma-separated hosts that must always be refused (production DB / site), in addition to the built-in list.
PRODUCTION_DB_HOSTS=""
PRODUCTION_HOSTS=""
