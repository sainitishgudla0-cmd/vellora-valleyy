// Velora Valley data model (PostgreSQL — Neon via the Vercel integration).
// DATABASE_URL          pooled connection used by the app at runtime
// DATABASE_URL_UNPOOLED direct connection used by `prisma db push` / migrations
// JSON-ish fields are stored as strings for portability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  tagline         String
  description     String
  primaryCategory String
  /// JSON array of category slugs
  categories      String
  /// JSON object of image paths (see src/data/types.ts ProductImages)
  images          String
  /// JSON array of short serving / usage suggestions
  uses            String    @default("[]")
  note            String?
  featured        Boolean   @default(false)
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  variants        Variant[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Variant {
  id               String              @id @default(cuid())
  sku              String              @unique // product barcode
  label            String // e.g. "250g", "10 pieces (400g)"
  weightGrams      Int
  /// selling price in paise
  price            Int
  /// brochure MRP in paise
  mrp              Int
  shelfLife        String
  hsCode           String
  image            String?
  /// Manual availability flag. Only authoritative while `trackInventory` is false; tracked variants derive availability from counts (src/lib/inventory).
  inStock          Boolean             @default(true)
  /// true = per-unit counts are authoritative (M3, ADR 0011). false = legacy manual `inStock` flag; stock and reserved are then always 0.
  trackInventory   Boolean             @default(false)
  /// Physical units on hand. Changed only by src/lib/inventory (DB CHECK: >= 0).
  stockQuantity    Int                 @default(0)
  /// Units held for open orders (reserved <= stockQuantity, DB CHECK). Changed only by src/lib/inventory.
  reserved         Int                 @default(0)
  sortOrder        Int                 @default(0)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  orderItems       OrderItem[]
  movements        InventoryMovement[]
  PriceListItem    PriceListItem[]
  VariantWholesale VariantWholesale[]
  QuoteItem        QuoteItem[]
}

/// What an inventory ledger row did (ADR 0011). Pairings are enforced by a DB CHECK.
enum InventoryReason {
  /// staff stock change (reservedDelta = 0, note required)
  adjustment
  /// units held for a new order (stockDelta = 0, reservedDelta > 0)
  reserve
  /// hold returned on cancellation/expiry (stockDelta = 0, reservedDelta < 0)
  release
  /// units left the warehouse on dispatch (stockDelta = reservedDelta < 0)
  fulfil
}

/// Append-only ledger of every stock/reservation change. SUM(stockDelta) = Variant.stockQuantity and SUM(reservedDelta) = Variant.reserved for tracked variants.
model InventoryMovement {
  id            String          @id @default(cuid())
  variantId     String
  variant       Variant         @relation(fields: [variantId], references: [id])
  /// Kept (set null) if the order row is ever deleted, so ledger sums stay equal to the counters.
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reason        InventoryReason
  stockDelta    Int
  reservedDelta Int
  stockAfter    Int
  reservedAfter Int
  note          String?
  actorType     OrderActorType
  actorId       String?
  createdAt     DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

/// Replay protection for POST /api/orders (M3-T4). Only a hash of the client key is stored.
model IdempotencyKey {
  id             String   @id @default(cuid())
  keyHash        String   @unique
  /// sha256 of the canonical request body: the same key with a different body is rejected.
  requestHash    String
  orderId        String?  @unique
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Filled once the response is final; NULL while the request is still being processed.
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

/// Values are the exact legacy strings, so API/JSON serialisation is unchanged (ADR 0005).
enum OrderStatus {
  pending_confirmation
  awaiting_payment
  confirmed
  paid
  dispatched
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
}

/// cod = pay on delivery (request-only: unpaid until externally confirmed); razorpay = online.
enum PaymentMethod {
  cod
  razorpay
}

model Order {
  id                 String              @id @default(cuid())
  number             String              @unique
  accessToken        String
  status             OrderStatus
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus       @default(unpaid)
  /// Server-resolved PAYMENT_MODE of the provider that handled this order. NULL = legacy/unclassified (created before M2-T4; never guessed).
  paymentMode        PaymentMode?
  customerName       String
  email              String
  phone              String
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  pincode            String
  notes              String?
  subtotal           Int
  deliveryFee        Int
  total              Int
  razorpayOrderId    String?             @unique
  razorpayPaymentId  String?
  items              OrderItem[]
  events             OrderEvent[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  idempotencyKey     IdempotencyKey?
  /// Set only server-side, from a signed-in customer's session or an explicit claim (M5). SetNull keeps the order if the account is erased.
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Set only for wholesale orders (M6), placed through /api/business/* or by accepting a quote.
  businessAccountId  String?
  businessAccount    BusinessAccount?    @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)
  quote              Quote?
  /// GST snapshot of the delivery charge and the supply type, taken at creation (NULL when no rate was configured).
  supplyType         String?
  deliveryGstRateBp  Int?
  deliveryTaxable    Int?
  deliveryCgst       Int?
  deliverySgst       Int?
  deliveryIgst       Int?
  invoice            Invoice?
  shipments          Shipment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([businessAccountId, createdAt])
}

/// Which integration handled a payment attempt (src/lib/payments/providers).
enum PaymentProvider {
  request_only
  mock
  razorpay
}

/// The PAYMENT_MODE a payment attempt was made under (ADR 0002). `mock` rows are never real money.
enum PaymentMode {
  mock
  request_only
  razorpay_test
  razorpay_live
}

/// One payment attempt for an order. Amounts are integer paise.
model Payment {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            PaymentProvider
  mode                PaymentMode
  providerOrderId     String?
  providerPaymentId   String?         @unique
  amount              Int
  currency            String          @default("INR")
  status              PaymentStatus   @default(unpaid)
  /// Set when the gateway outcome is unknown/pending (timeout, authorized-not-captured, lost response); cleared when resolved. See src/lib/payments/reconcile.ts.
  needsReconciliation Boolean         @default(false)
  /// Short machine code for why (never gateway payloads or customer data).
  reconcileReason     String?
  lastCheckedAt       DateTime?
  /// Staff-entered external payment reference (UPI/bank/cash-receipt id) when a request-only payment was confirmed manually (M2-T6). Unique: one external payment cannot confirm two orders.
  manualReference     String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([orderId])
  @@index([needsReconciliation, createdAt])
  @@index([providerOrderId])
}

/// Who initiated a status change (ADR 0006).
enum OrderActorType {
  customer
  admin
  system
  gateway
}

/// Append-only history of order/payment status changes, written only by src/lib/orders/state-machine.ts.
/// Cascade keeps `db:cleanup-tests` working; real orders are never deleted.
model OrderEvent {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus        OrderStatus
  toStatus          OrderStatus
  fromPaymentStatus PaymentStatus?
  toPaymentStatus   PaymentStatus?
  actorType         OrderActorType
  actorId           String?
  reason            String?
  /// Manual payment confirmation reference (same value as Payment.manualReference).
  paymentReference  String?
  createdAt         DateTime       @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  variant      Variant @relation(fields: [variantId], references: [id])
  variantId    String
  productName  String
  variantLabel String
  sku          String
  unitPrice    Int
  quantity     Int
  lineTotal    Int
  /// GST snapshot (M7, ADR 0015). NULL = no tax rate was configured when the order was placed; the invoice computes it from the rates in force on the order date.
  hsCode       String?
  gstRateBp    Int?
  taxableValue Int?
  cgst         Int?
  sgst         Int?
  igst         Int?
}

model Enquiry {
  id        String   @id @default(cuid())
  /// contact | business
  type      String
  name      String
  email     String
  phone     String?
  company   String?
  city      String?
  /// business interest, e.g. distributor | retail | bulk | horeca | export | franchise
  interest  String?
  message   String
  /// new | in_progress | closed
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Staff roles (M4, ADR 0012). Permissions per role live in src/lib/auth/roles.ts.
enum AdminRole {
  owner
  operations
  catalog
  viewer
}

/// An individual staff account. Passwords are stored as scrypt hashes only.
model AdminUser {
  id                String         @id @default(cuid())
  /// lower-cased
  email             String         @unique
  name              String
  passwordHash      String
  role              AdminRole
  active            Boolean        @default(true)
  /// consecutive failed logins; reset on success
  failedLogins      Int            @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          AdminSession[]
}

/// Server-side session. The cookie holds a random token; only its keyed hash is stored, so a database read cannot be replayed.
/// `legacy` sessions come from the shared ADMIN_PASSWORD (transition only) and have no user.
model AdminSession {
  id         String     @id @default(cuid())
  userId     String?
  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacy     Boolean    @default(false)
  tokenHash  String     @unique
  userAgent  String?
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only record of admin logins and mutations. No FK to AdminUser so history survives account changes.
/// `details` holds ids and changed field names only: never passwords, tokens, reasons or customer data.
model AuditLog {
  id          String   @id @default(cuid())
  /// e.g. "order.update", "login.success"
  action      String
  /// success | rejected | denied | failed
  outcome     String
  actorUserId String?
  /// email of the account, "legacy" for the shared password, or "anonymous" for failed logins
  actorLabel  String
  actorRole   String?
  targetType  String?
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

/// A shopper's account (M5, ADR 0013). Sign-in is by emailed one-time code; there is no password.
model Customer {
  id               String            @id @default(cuid())
  /// lower-cased; verified by the sign-in code
  email            String            @unique
  name             String?
  phone            String?
  marketingConsent Boolean           @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         CustomerSession[]
  addresses        Address[]
  consents         ConsentRecord[]
  orders           Order[]
  businessAccount  BusinessAccount?
}

/// Server-side customer session; only a keyed hash of the cookie token is stored (same scheme as AdminSession).
model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([customerId])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  /// at most one per customer (partial unique index in the migration)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

/// One emailed sign-in code. Neither the address nor the code is stored in the clear: both are keyed hashes.
model OtpChallenge {
  id         String    @id @default(cuid())
  emailHash  String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([emailHash, createdAt])
  @@index([expiresAt])
}

/// Append-only consent history (DPDP Act 2023): what was agreed (`terms_privacy` or `marketing`), which notice version, when.
model ConsentRecord {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    String
  granted    Boolean
  version    String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// Wholesale (M6, ADR 0014).
enum BusinessAccountStatus {
  pending
  approved
  rejected
  suspended
  closed
}

enum PaymentTerms {
  prepaid
  credit
}

enum QuoteStatus {
  requested
  quoted
  accepted
  declined
  expired
  rejected
  cancelled
}

/// A named set of wholesale prices (quantity tiers per variant). Accounts point at one; without one they pay the retail price.
model PriceList {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  active      Boolean           @default(true)
  items       PriceListItem[]
  accounts    BusinessAccount[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// Price per unit (integer paise) from `minQty` units upward; the row with the highest minQty <= quantity applies.
model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id])
  minQty      Int       @default(1)
  unitPrice   Int

  @@unique([priceListId, variantId, minQty])
  @@index([variantId])
}

/// Minimum order quantity and case pack for wholesale buyers. No row = no restriction. Retail is never affected.
model VariantWholesale {
  variantId String   @id
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  moq       Int      @default(1)
  casePack  Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// A business buyer. Linked to a verified customer (M5 sign-in) by `customerId`, or by `contactEmail` until that person signs in.
model BusinessAccount {
  id           String                @id @default(cuid())
  customerId   String?               @unique
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// lower-cased; the verified owner of this address is linked on first sign-in
  contactEmail String
  companyName  String
  gstin        String
  contactName  String
  phone        String
  /// one of BUSINESS_INTERESTS
  interest     String?
  message      String?
  status       BusinessAccountStatus @default(pending)
  priceListId  String?
  priceList    PriceList?            @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  paymentTerms PaymentTerms          @default(prepaid)
  /// paise; only meaningful for `credit` terms
  creditLimit  Int                   @default(0)
  adminNote    String?
  approvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  orders       Order[]
  quotes       Quote[]

  @@index([contactEmail])
  @@index([status, createdAt])
}

model Quote {
  id                String          @id @default(cuid())
  number            String          @unique
  businessAccountId String
  businessAccount   BusinessAccount @relation(fields: [businessAccountId], references: [id])
  status            QuoteStatus     @default(requested)
  requestNote       String?
  /// shown to the buyer with the quote (terms, delivery remarks); internal notes belong on the account
  buyerNote         String?
  /// set when quoted (paise)
  deliveryFee       Int?
  subtotal          Int?
  total             Int?
  validUntil        DateTime?
  quotedAt          DateTime?
  decidedAt         DateTime?
  /// the order created when the quote was accepted
  orderId           String?         @unique
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items             QuoteItem[]
  events            QuoteEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([businessAccountId, createdAt])
  @@index([status, validUntil])
}

model QuoteItem {
  id           String  @id @default(cuid())
  quoteId      String
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id])
  productName  String
  variantLabel String
  sku          String
  quantity     Int
  /// set when quoted
  unitPrice    Int?
  lineTotal    Int?

  @@unique([quoteId, variantId])
}

/// Append-only quote history (who moved it where). Written only by src/lib/wholesale/quote-machine.ts.
model QuoteEvent {
  id         String         @id @default(cuid())
  quoteId    String
  quote      Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fromStatus QuoteStatus
  toStatus   QuoteStatus
  actorType  OrderActorType
  actorId    String?
  createdAt  DateTime       @default(now())

  @@index([quoteId, createdAt])
}

/// GST rate for an HSN code (4, 6 or 8 digits; the most specific match wins) or the reserved code DELIVERY, from `effectiveFrom`. Append-only: a rate change is a new row. (M7, ADR 0015)
model TaxRate {
  id            String   @id @default(cuid())
  code          String
  /// basis points: 500 = 5.00%
  rateBp        Int
  effectiveFrom DateTime @db.Date
  note          String?
  createdAt     DateTime @default(now())

  @@unique([code, effectiveFrom])
}

/// Gap-free invoice counter per financial year (April-March), advanced in the same transaction as the invoice row.
model InvoiceSeries {
  financialYear String @id
  lastSeq       Int    @default(0)
}

/// An issued tax invoice. `payload` is the frozen, canonical snapshot the PDF is rendered from (never recomputed), so an invoice regenerates byte-for-byte.
model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  financialYear String
  seq           Int
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  issuedAt      DateTime
  supplyType    String
  taxableTotal  Int
  cgstTotal     Int
  sgstTotal     Int
  igstTotal     Int
  total         Int
  buyerGstin    String?
  payload       String
  createdAt     DateTime @default(now())

  @@unique([financialYear, seq])
}

/// Delivery serviceability and fee by pincode prefix. With NO active rules the legacy behaviour applies (site fee, everywhere); with any rule, an order's pincode needs a matching rule.
model ShippingRule {
  id                String   @id @default(cuid())
  name              String
  /// 1-6 digits; empty = catch-all. The longest matching prefix wins.
  pincodePrefix     String   @default("")
  serviceable       Boolean  @default(true)
  /// paise
  fee               Int      @default(0)
  /// subtotal (paise) from which the fee is waived
  freeAboveSubtotal Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([pincodePrefix])
}

enum ShipmentStatus {
  created
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned
}

model Shipment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier     String
  awb         String
  trackingUrl String?
  status      ShipmentStatus  @default(created)
  events      ShipmentEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([courier, awb])
  @@index([orderId])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now())

  @@index([shipmentId, createdAt])
}

enum OutboxStatus {
  pending
  sending
  sent
  failed
  dead
}

/// Transactional notification queue (M7-T5). Written in the same transaction as the event it announces (dedupeKey makes that idempotent);
/// content is rendered from the database at send time, so no personal data or order links are copied here.
model OutboxMessage {
  id            String       @id @default(cuid())
  channel       String       @default("email")
  template      String
  /// the order or quote the message is about
  subjectType   String
  subjectId     String
  dedupeKey     String       @unique
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  claimedAt     DateTime?
  sentAt        DateTime?
  /// short machine code, never a recipient or provider payload
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([status, nextAttemptAt])
}
