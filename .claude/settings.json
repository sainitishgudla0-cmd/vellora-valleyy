{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./public/images/**)",
      "Read(./.next/**)",
      "Read(./node_modules/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production*)",
      "Bash(npx prisma db push:*)",
      "Bash(prisma db push:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(npm run db:migrate:deploy:production:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(npx vercel:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
