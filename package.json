{
  "name": "velora-valley",
  "version": "1.0.0",
  "private": true,
  "description": "Velora Valley — premium dry fruits, nuts, dates & seeds by Anantha Food Products",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "npm run env:check && prisma generate && next build",
    "start": "next start",
    "env:check": "tsx scripts/check-env.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=12",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:api": "tsx scripts/smoke-test.ts",
    "test:ui": "playwright test",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run env:check",
    "verify:full": "tsx scripts/verify-full.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "tsx scripts/db-guard.ts \"migrate dev\" && prisma migrate dev",
    "db:migrate:deploy": "tsx scripts/db-guard.ts \"migrate deploy\" && prisma migrate deploy",
    "db:migrate:deploy:production": "tsx scripts/db-guard.ts \"production migrate deploy\" --production && prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:schema:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:baseline:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:migrate:deploy && npm run db:seed",
    "payments:reconcile": "tsx scripts/db-guard.ts \"payments reconcile\" --production && tsx --conditions=react-server scripts/reconcile-payments.ts",
    "admin:bootstrap": "tsx scripts/db-guard.ts \"admin bootstrap\" --production && tsx --conditions=react-server scripts/admin-bootstrap.ts",
    "payments:mock-checkout": "tsx scripts/mock-checkout.ts",
    "db:cleanup-tests": "tsx --conditions=react-server scripts/cleanup-test-data.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@prisma/client": "5.22.0",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "gsap": "3.13.0",
    "lenis": "1.1.20",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "20.17.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.32",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.23.1": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
